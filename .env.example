# ============================================================
# DevAgent AI — Environment Configuration Template
# Copy to .env (do NOT commit secrets or real .env to GitHub)
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# ------------------------------------------------------------
# Deployed FastAPI backend URL (leave blank for local dev proxy)
# Example for production: https://your-backend.fastapicloud.com
VITE_API_BASE_URL=

# ------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (FastAPI Cloud / Local)
# ------------------------------------------------------------
API_V1_PREFIX=/api/v1
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Allowed CORS origins (comma-separated). Add your Vercel frontend domain here!
# Example: http://localhost:5173,http://localhost:3000,https://your-devagent-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Database & Persistent Storage
# SQLite file URL. On FastAPI Cloud or cloud persistent volumes, point to mounted persistent disk
DATABASE_URL=sqlite:///./app_data/database/devagent.db
APP_DATA_DIR=./app_data

# Security limits & Timeouts
COMMAND_TIMEOUT_SECONDS=30
MAX_FILE_SIZE_BYTES=1048576
MAX_OUTPUT_CHARS=10000

# ------------------------------------------------------------
# 3. AI / LLM PROVIDER CREDENTIALS (Stored securely in cloud)
# ------------------------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
HOSTED_LLM_PROVIDER=
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b