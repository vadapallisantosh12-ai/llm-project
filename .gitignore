# ============================================================
# DevAgent AI — .gitignore
# Excludes local virtualenvs, node_modules, build outputs,
# environment files, databases, logs, and sensitive data.
# ============================================================

# 1. Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 2. Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# 3. Deployment & Cloud Provider artifacts
.vercel
.fastapi-cloud
.serverless/

# 4. DevAgent Local Storage & Databases
app_data/database/*.db
app_data/database/*.sqlite
app_data/database/*.sqlite3
app_data/database/*.json
app_data/logs/*.log
app_data/temporary/*
app_data/backups/*
app_data/indexes/*
app_data/audit/*
!app_data/**/.gitkeep
*.bak

# 5. Environment variables, tokens & secrets
.env
.env.local
.env.*.local
.dev.env.json
.dev.pid
*.pem
*.key
*.cert
*.pfx

# 6. Operating System
Thumbs.db
Desktop.ini
.DS_Store

# 7. IDE & Tooling
.idea/
.vscode/
*.swp
*.swo
.cursor/
.aistudio/
