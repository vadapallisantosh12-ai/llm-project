# DevAgent AI Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment.

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Paths
APP_DATA_DIR=./app_data
DATABASE_URL=sqlite:///./app_data/database/devagent.db

# LLM Provider Configuration (mock, ollama, hosted)
DEFAULT_LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Optional Hosted LLM Provider
HOSTED_LLM_PROVIDER=openai
HOSTED_LLM_BASE_URL=https://api.openai.com/v1
HOSTED_LLM_API_KEY=

# Execution & Limits
COMMAND_TIMEOUT_SECONDS=30
MAX_FILE_SIZE_BYTES=1048576
MAX_OUTPUT_CHARS=100000

# Logging
LOG_LEVEL=INFO
